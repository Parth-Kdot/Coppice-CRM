# Copy this file to .env and fill in real values. Never commit .env.

# Database. Locally both point at the Docker Postgres from docker-compose.yml.
# DATABASE_URL is what the app uses, as app_user: a role that can't bypass row-level security.
# DIRECT_URL is the owner role, used only by prisma migrate. After `docker compose up -d db`,
# run `npm run db:setup` once to apply migrations and give app_user its local password.
# In production (Vercel): DATABASE_URL is Supabase's transaction pooler (port 6543) as
# app_user.<project-ref>, with no sslmode. DIRECT_URL is NOT set on Vercel; migrations run from
# a developer machine through Supabase's session pooler (port 5432) as postgres.<project-ref>.
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/boilerpitch"
DIRECT_URL="postgresql://boilerpitch:boilerpitch@localhost:5432/boilerpitch"

# Production only: Supabase's public root certificate (Database settings > SSL), as PEM text.
# With it the app verifies it's really talking to Supabase. Leave unset locally.
# DATABASE_CA_CERT=""

# Better Auth (used from Milestone 1). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (created in Google Cloud Console during Milestone 1).
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# Option B: comma-separated emails allowed to create workspaces. Everyone else joins by invitation.
WORKSPACE_CREATOR_EMAILS="you@example.com"

# AI (feature 1, the Pitch Drafter). A Google AI Studio key: aistudio.google.com/apikey.
# Leave billing off on that Google project so the free tier can never charge you; past its
# limits, calls are refused rather than billed. Without a key, AI features say so and stay off.
GEMINI_API_KEY=""

# Optional, local only: `npm run db:seed` adds the user with this email (who must have signed in
# locally once) as an owner of the demo workspace.
# SEED_OWNER_EMAIL=""
