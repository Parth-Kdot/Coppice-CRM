# Copy this file to .env and fill in real values. Never commit .env.

# Database. Locally both point at the Docker Postgres from docker-compose.yml.
# DATABASE_URL is what the app uses, as app_user: a role that can't bypass row-level security.
# DIRECT_URL is the owner role, used only by prisma migrate. After `docker compose up -d db`,
# run `npm run db:setup` once to apply migrations and give app_user its local password.
# In production: DATABASE_URL is Supabase's pooled connection as app_user,
# DIRECT_URL is Supabase's direct connection as the owner.
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/boilerpitch"
DIRECT_URL="postgresql://boilerpitch:boilerpitch@localhost:5432/boilerpitch"

# Better Auth (used from Milestone 1). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (created in Google Cloud Console during Milestone 1).
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# Option B: comma-separated emails allowed to create workspaces. Everyone else joins by invitation.
WORKSPACE_CREATOR_EMAILS="you@example.com"
