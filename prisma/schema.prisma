// Prisma schema: the single source of truth for database tables.
// The auth and workspace models (User through Invitation, plus RateLimit) are generated by
// `npx auth@1.7.10 generate` from lib/auth.ts. The generator rewrites the whole file, so regenerate
// into a scratch file and copy over only what changed: keep the Membership @@unique line, the
// app relation fields on User and Workspace, and every model from Company down.
// Run `npx prisma generate` after every change.

generator client {
  provider = "prisma-client"
  // Machine-written code lives in /generated, never edited by hand and gitignored.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sessions         Session[]
  accounts         Account[]
  memberships      Membership[]
  invitations      Invitation[]
  // App relations (not from the generator).
  claimedCompanies Company[]    @relation("CompanyClaims")
  outreach         Outreach[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                String   @id
  expiresAt         DateTime
  token             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ipAddress         String?
  userAgent         String?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspaceId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id              String       @id
  name            String
  slug            String
  logo            String?
  createdAt       DateTime
  metadata        String?
  claimWindowDays Int          @default(14)
  memberships     Membership[]
  invitations     Invitation[]
  // App relations (not from the generator).
  companies       Company[]
  contacts        Contact[]
  templates       Template[]
  outreach        Outreach[]

  @@unique([slug])
  @@map("workspace")
}

model Membership {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  createdAt   DateTime

  // One membership per person per workspace, even if two joins race.
  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("membership")
}

model Invitation {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String?
  status      String    @default("pending")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  inviterId   String
  user        User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("invitation")
}

// Better Auth's rate limiter (lib/auth.ts). One row per client IP and auth path. No workspace data.
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ---------------------------------------------------------------------------------------------
// App tables. Every one carries workspaceId and is protected by row-level security (see the
// tenant_rls migration): the database only shows rows of the workspace set by withTenant in
// lib/db.ts, and only to a member of it. A new table here needs its own policy in its migration.
//
// Times compared with the database clock (claims, follow-ups) are timestamptz, so the comparison
// never depends on a connection's time zone.

enum Stage {
  NOT_CONTACTED
  CONTACTED
  REPLIED
  IN_CONVERSATION
  COMMITTED
  DECLINED
}

enum Channel {
  EMAIL
  LINKEDIN
  IN_PERSON
  OTHER
}

model Company {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  industry        String?
  website         String?
  notes           String?
  stage           Stage     @default(NOT_CONTACTED)
  nextFollowUpAt  DateTime? @db.Timestamptz(3)
  lastContactedAt DateTime? @db.Timestamptz(3)
  // Written only by lib/claims.ts (Milestone 3).
  claimedById     String?
  claimExpiresAt  DateTime? @db.Timestamptz(3)
  archivedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  claimedBy User?      @relation("CompanyClaims", fields: [claimedById], references: [id], onDelete: SetNull)
  contacts  Contact[]
  outreach  Outreach[]

  // Lets contacts and outreach point at (company, workspace) together, so a row can never
  // link to a company in a different workspace.
  @@unique([id, workspaceId])
  @@index([workspaceId, nextFollowUpAt])
  @@index([workspaceId, name])
  @@index([claimedById])
}

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  name        String
  email       String?
  title       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([companyId, workspaceId])
  @@index([workspaceId])
}

model Template {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  body        String
  // Templates that were used are archived, never deleted, so stats keep their history.
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outreach  Outreach[]

  @@index([workspaceId])
}

model Outreach {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  senderId    String
  // Must be a template of the same workspace; the RLS policy checks this (see tenant_rls).
  templateId  String?
  channel     Channel  @default(EMAIL)
  sentAt      DateTime @default(now()) @db.Timestamptz(3)
  note        String?
  gotReply    Boolean  @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  // Restrict: outreach history outlives people and templates (both are archived, not deleted).
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  template  Template? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([workspaceId, templateId])
  @@index([companyId, workspaceId])
  @@index([senderId])
  @@index([templateId])
}
