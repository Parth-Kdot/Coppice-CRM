// Prisma schema: the single source of truth for database tables.
// The auth and workspace models (User through Invitation, plus RateLimit, and the OAuth models Jwks
// through OauthClientAssertion) are generated by `npx auth@1.7.10 generate` from lib/auth.ts. The
// generator rewrites the whole file, so regenerate into a scratch file and copy over only what
// changed: keep the Membership @@unique line, the app relation fields on User (including
// mcpRateLimits) and Workspace, and every model from the App tables divider down.
// Run `npx prisma generate` after every change.

generator client {
  provider = "prisma-client"
  // Machine-written code lives in /generated, never edited by hand and gitignored.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                @id
  name             String
  email            String
  emailVerified    Boolean               @default(false)
  image            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sessions         Session[]
  accounts         Account[]
  memberships      Membership[]
  invitations      Invitation[]
  // App relations (not from the generator).
  claimedCompanies Company[]             @relation("CompanyClaims")
  outreach         Outreach[]
  stageChanges     StageChange[]
  pairDecisions    CompanyPairDecision[]
  aiRuns           AiRun[]
  factSheets       FactSheet[]
  factsCreated     FactSheetItem[]       @relation("FactCreatedBy")
  factsVerified    FactSheetItem[]       @relation("FactVerifiedBy")
  aiDrafts         AiDraft[]
  importSessions   ImportSession[]
  researchSources  ResearchSource[]
  companyBriefs    CompanyBrief[]
  onboarding       OnboardingProgress[]
  // From the MCP plugin (lib/auth.ts), via the generator.
  oauthclients       OauthClient[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]
  // App relation (not from the generator): the MCP rate limit.
  mcpRateLimits      McpRateLimit[]
  // App relations (not from the generator): AI feature 7.
  scorecardNarratives ScorecardNarrative[]
  startedExperiments  TemplateExperiment[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                String   @id
  expiresAt         DateTime
  token             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ipAddress         String?
  userAgent         String?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspaceId String?
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id              String                @id
  name            String
  slug            String
  logo            String?
  createdAt       DateTime
  metadata        String?
  claimWindowDays Int                   @default(14)
  // AI features (owner settings). Off until an owner turns it on; the limit counts AI calls in
  // the last 30 days across the workspace (lib/ai/run.ts).
  aiEnabled       Boolean               @default(false)
  aiMonthlyLimit  Int                   @default(300)
  // MCP (outside AI assistants, app/api/mcp). Off until an owner turns it on in Settings.
  mcpEnabled      Boolean               @default(false)
  memberships     Membership[]
  invitations     Invitation[]
  // App relations (not from the generator).
  companies       Company[]
  contacts        Contact[]
  templates       Template[]
  outreach        Outreach[]
  stageChanges    StageChange[]
  pairDecisions   CompanyPairDecision[]
  aiRuns          AiRun[]
  factSheets      FactSheet[]
  factSheetPages  FactSheetPage[]
  factSheetItems  FactSheetItem[]
  aiDrafts        AiDraft[]
  importSessions  ImportSession[]
  importChunks    ImportChunk[]
  researchSources ResearchSource[]
  companyBriefs   CompanyBrief[]
  briefPages      CompanyBriefPage[]
  onboarding      OnboardingProgress[]
  scorecardNarratives ScorecardNarrative[]
  templateExperiments TemplateExperiment[]
  experimentArms      ExperimentArm[]

  @@unique([slug])
  @@map("workspace")
}

model Membership {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  createdAt   DateTime

  // One membership per person per workspace, even if two joins race.
  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("membership")
}

model Invitation {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String?
  status      String    @default("pending")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  inviterId   String
  user        User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("invitation")
}

// Better Auth's rate limiter (lib/auth.ts). One row per client IP and auth path. No workspace data.
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ----- MCP: OAuth for outside AI assistants (lib/auth.ts jwt() and mcp()), from the generator.
// jwks holds the token signing keys; private keys are encrypted with BETTER_AUTH_SECRET.
// No workspace data in any of these.

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauthResource")
}

model OauthClientResource {
  id            String        @id
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

// ---------------------------------------------------------------------------------------------
// App tables. Every one carries workspaceId and is protected by row-level security (see the
// tenant_rls migration): the database only shows rows of the workspace set by withTenant in
// lib/db.ts, and only to a member of it. A new table here needs its own policy in its migration.
// The one exception is McpRateLimit, just below, which is keyed by user and holds no workspace data.
//
// Times compared with the database clock (claims, follow-ups) are timestamptz, so the comparison
// never depends on a connection's time zone.

// Per-person limit on MCP tool calls (lib/mcp/rate-limit.ts): one row per person, kind of call and
// minute. Shared by every server instance. The one app table without workspaceId: it is keyed by
// user and holds no workspace data, so on purpose it has no row-level security (like rateLimit).
// Old minutes are deleted as new ones are counted.
model McpRateLimit {
  userId      String
  kind        String
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, windowStart])
}

enum Stage {
  NOT_CONTACTED
  CONTACTED
  REPLIED
  IN_CONVERSATION
  COMMITTED
  DECLINED
}

enum Channel {
  EMAIL
  LINKEDIN
  IN_PERSON
  OTHER
}

// Where a claim, an outreach entry or a stage move was made: in the app, or by the person's AI
// assistant through the MCP server. The company page marks assistant-made history.
enum Via {
  APP
  ASSISTANT
}

model Company {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  industry        String?
  website         String?
  notes           String?
  // Duplicate-matching keys, computed by lib/duplicates.ts on every write: the name lowercased
  // without punctuation or legal suffixes ("Acme, Inc." -> "acme"), and the website's domain.
  nameKey         String
  domainKey       String?
  stage           Stage     @default(NOT_CONTACTED)
  nextFollowUpAt  DateTime? @db.Timestamptz(3)
  lastContactedAt DateTime? @db.Timestamptz(3)
  // Written only by lib/claims.ts (Milestone 3).
  claimedById     String?
  claimExpiresAt  DateTime? @db.Timestamptz(3)
  // How the latest claim was made (app or assistant). Only meaningful while claimedById is set;
  // null for claims made before this column existed.
  claimedVia      Via?
  archivedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  claimedBy    User?                 @relation("CompanyClaims", fields: [claimedById], references: [id], onDelete: SetNull)
  contacts     Contact[]
  outreach     Outreach[]
  stageChanges StageChange[]
  pairsAsA     CompanyPairDecision[] @relation("PairCompanyA")
  pairsAsB     CompanyPairDecision[] @relation("PairCompanyB")
  aiDrafts     AiDraft[]
  briefs       CompanyBrief[]

  // Lets contacts and outreach point at (company, workspace) together, so a row can never
  // link to a company in a different workspace.
  @@unique([id, workspaceId])
  @@index([workspaceId, nextFollowUpAt])
  // The board: each column is one stage, sorted by follow-up date.
  @@index([workspaceId, stage, nextFollowUpAt])
  @@index([workspaceId, name])
  @@index([workspaceId, nameKey])
  @@index([workspaceId, domainKey])
  @@index([claimedById])
}

// Every stage move, kept forever: who moved which company from what to what, and when.
// Written only by changeStage in lib/claims.ts. Later AI features read the history.
model StageChange {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  changedById String
  fromStage   Stage
  toStage     Stage
  via         Via      @default(APP)
  changedAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  // Restrict: history outlives people.
  changedBy User      @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([companyId, workspaceId])
  @@index([workspaceId, changedAt])
  @@index([changedById])
}

// A person looked at two look-alike companies and said "these are separate", so the pair is
// never flagged as a duplicate again. companyAId is always the smaller id (enforced by a CHECK in
// the migration), so each pair has exactly one row.
model CompanyPairDecision {
  id          String   @id @default(cuid())
  workspaceId String
  companyAId  String
  companyBId  String
  decidedById String
  decidedAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyA  Company   @relation("PairCompanyA", fields: [companyAId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  companyB  Company   @relation("PairCompanyB", fields: [companyBId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  decidedBy User      @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, companyAId, companyBId])
  @@index([companyAId, workspaceId])
  @@index([companyBId, workspaceId])
  @@index([decidedById])
}

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  name        String
  email       String?
  title       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  aiDrafts  AiDraft[]

  @@index([companyId, workspaceId])
  @@index([workspaceId])
}

model Template {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  body        String
  // Templates that were used are archived, never deleted, so stats keep their history.
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  // The Template Lab (AI feature 7): a variant's base template (same workspace, composite key) and
  // the one-line summary of what it changes. Both null for an ordinary template.
  familyId    String?
  variantNote String?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outreach  Outreach[]
  // NoAction (checked at the end of the statement), so deleting a whole workspace can cascade
  // through a template and its variants together.
  family    Template?  @relation("TemplateFamily", fields: [familyId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  variants  Template[] @relation("TemplateFamily")
  experimentsAsBase TemplateExperiment[] @relation("ExperimentBase")
  experimentsKept   TemplateExperiment[] @relation("ExperimentKept")
  experimentArms    ExperimentArm[]

  @@index([workspaceId])
  @@unique([id, workspaceId])
  @@index([familyId, workspaceId])
}

model Outreach {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  senderId    String
  // Must be a template of the same workspace; the RLS policy checks this (see tenant_rls).
  templateId  String?
  channel     Channel  @default(EMAIL)
  sentAt      DateTime @default(now()) @db.Timestamptz(3)
  note        String?
  gotReply    Boolean  @default(false)
  via         Via      @default(APP)
  // The AI draft this email came from, if any (AI feature 1), so stats can compare AI-drafted and
  // hand-written emails. Always a draft of the same workspace (composite key).
  aiDraftId   String?
  // A key the log form makes once per entry (a UUID), so a double submit, a retry after a
  // timeout or a second tab can never log the same outreach twice. Null for rows logged
  // before it existed and for the AI assistant's logs.
  clientKey   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  // Restrict: outreach history outlives people and templates (both are archived, not deleted).
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  template  Template? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  // NoAction (checked at the end of the statement) rather than Restrict, so deleting a whole
  // workspace or company can cascade through drafts and outreach together.
  aiDraft   AiDraft?  @relation(fields: [aiDraftId, workspaceId], references: [id, workspaceId], onDelete: NoAction)

  @@index([workspaceId, templateId])
  @@index([aiDraftId, workspaceId])
  @@index([companyId, workspaceId])
  // A company's latest outreach first (the queue's last note, the company page's log).
  @@index([companyId, workspaceId, sentAt(sort: Desc)])
  @@index([senderId])
  @@index([templateId])
  @@unique([workspaceId, clientKey])
}

// ----- AI (feature 1: the Fact-Locked Pitch Drafter) -----

enum AiFeature {
  FACT_EXTRACTION
  DRAFT
  CLAIM_CHECK
  // Smart import (AI feature 3): column suggestions and look-alike names (Gemini), and reading
  // free-text cells (Groq).
  IMPORT_MAPPING
  IMPORT_LOOKALIKES
  IMPORT_ROWS
  // AI feature 2, the Research Agent: reading the fetched pages, then writing the brief.
  RESEARCH_READ
  RESEARCH_BRIEF
  // AI feature 7: the stats page's numbers explanation, and the Template Lab's variants.
  SCORECARD_EXPLAIN
  TEMPLATE_LAB
}

enum AiRunStatus {
  SUCCEEDED
  FAILED
  // A call reserved before it is made (lib/ai/run.ts reserveAi), so calls made at the same moment
  // can't all pass the limits; it becomes SUCCEEDED or FAILED once the model answers.
  RUNNING
}

enum FactSource {
  PDF
  MANUAL
}

enum DraftKind {
  FIRST_TOUCH
  FOLLOW_UP
}

// One row per call to an AI model: who, what for, which model, how long, how many tokens, and
// whether it worked. The workspace's limits count these (lib/ai/run.ts).
model AiRun {
  id             String      @id @default(cuid())
  workspaceId    String
  userId         String
  feature        AiFeature
  model          String
  status         AiRunStatus
  // A short code such as "rate_limited" or "blocked"; never the prompt or the reply. On a
  // SUCCEEDED call that a fallback model answered, a short note of the models that failed first
  // ("fallback after gemini-3.6-flash timeout 20004ms"), so slow fallbacks show in the log.
  error          String?
  promptTokens   Int?
  outputTokens   Int?
  thinkingTokens Int?
  latencyMs      Int
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([userId, feature, createdAt])
}

// An uploaded sponsorship packet. Its text is kept page by page, so quotes the AI returns can be
// checked against exactly what it was shown.
model FactSheet {
  id           String   @id @default(cuid())
  workspaceId  String
  fileName     String
  pageCount    Int
  uploadedById String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  pages      FactSheetPage[]
  items      FactSheetItem[]

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([uploadedById])
}

model FactSheetPage {
  id          String @id @default(cuid())
  workspaceId String
  factSheetId String
  pageNumber  Int
  text        String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  factSheet FactSheet @relation(fields: [factSheetId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([factSheetId, pageNumber])
  @@index([factSheetId, workspaceId])
  @@index([workspaceId])
}

// One fact the AI may state about the org. Nothing is used until a person verifies it.
model FactSheetItem {
  id           String     @id @default(cuid())
  workspaceId  String
  // Null for facts typed in by hand.
  factSheetId  String?
  source       FactSource
  text         String
  // From a PDF: the sentence it came from, its page, and whether code found that sentence on
  // that page of the stored text.
  quote        String?
  pageNumber   Int?
  quoteFound   Boolean    @default(false)
  verifiedAt   DateTime?  @db.Timestamptz(3)
  verifiedById String?
  createdById  String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  factSheet  FactSheet? @relation(fields: [factSheetId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy  User       @relation("FactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy User?      @relation("FactVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, verifiedAt])
  @@index([factSheetId, workspaceId])
  @@index([createdById])
  @@index([verifiedById])
}

// One drafted email (each Draft click makes two, with different angles). The body keeps its
// {{firstName}}-style placeholders; names are filled in on screen, never sent to the AI.
model AiDraft {
  id          String    @id @default(cuid())
  workspaceId String
  companyId   String
  // Must be a contact of the same workspace; the RLS policy checks this (see the migration).
  contactId   String?
  createdById String
  kind        DraftKind
  angle       String
  subject     String
  body        String
  // The Claim Checker's findings for this draft (lib/ai/claim-check.ts).
  check       Json?
  model       String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  outreach  Outreach[]

  @@unique([id, workspaceId])
  @@index([companyId, workspaceId, createdAt])
  @@index([workspaceId])
  @@index([contactId])
  @@index([createdById])
}

// ----- Smart import (AI feature 3: the Sheet Archaeologist) -----

// One Smart import in progress: the file it reads (by hash, since the file itself is sent again
// with every step), the column choices it was read with, and the sheet's board year. The browser
// sends the free-text rows a chunk at a time; each chunk's checked proposals are staged in
// ImportChunk, and nothing touches companies until the final import, which deletes the session.
// Sessions older than 24 hours are ignored, and removed the next time the same person starts one
// (only its creator can see a session; lib/smart-import/).
model ImportSession {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  fileHash    String
  // ImportMapping, the free-text columns, and the rows to read, as the session was started.
  mapping     Json
  freeText    Json
  rows        Json
  cycleStart  Int
  chunkCount  Int
  // Look-alike pairs the AI suggested, checked by code (row numbers and existing company ids).
  lookalikes  Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  chunks    ImportChunk[]

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([createdById])
}

// The checked proposals for one chunk of rows: what the AI read, each with the cell text it quoted.
model ImportChunk {
  id          String   @id @default(cuid())
  workspaceId String
  sessionId   String
  index       Int
  proposals   Json
  model       String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   ImportSession @relation(fields: [sessionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([sessionId, index])
  @@index([sessionId, workspaceId])
  @@index([workspaceId])
}

// ----- AI (feature 2: the Research Agent) -----

// A web page an owner approved for research briefs. The server fetches only these URLs (and
// redirects that stay on one of their hosts), never anything else. Removing one archives it.
model ResearchSource {
  id          String    @id @default(cuid())
  workspaceId String
  url         String
  label       String
  addedById   String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addedBy   User      @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, archivedAt])
  @@index([addedById])
}

enum BriefStatus {
  // The AI read the pages; the brief may still have no items if nothing on them checked out.
  READY
  // No page could be read (robots.txt, blocked, too big ...), so no AI call was made.
  NO_PAGES
  // Being prepared: the row is written before any page is fetched, so it holds this person's slot
  // in the daily limit (lib/research/brief.ts). Never shown.
  RUNNING
  // An AI call failed or the brief stopped with an error. Never shown, but it still counts.
  FAILED
}

// A suggested "who to contact" brief for a company, built from approved pages only. Every item
// carries a quote that code found on the page it cites. Nothing here changes the company until a
// person accepts an item (lib/research/brief.ts).
model CompanyBrief {
  id          String      @id @default(cuid())
  workspaceId String
  companyId   String
  createdById String
  status      BriefStatus
  // The checked items: { items: BriefItem[] }, each citing one of this brief's pages.
  brief       Json
  // Ids of items a person added to the company's notes.
  accepted    String[]    @default([])
  // Which model wrote the brief; null when no AI call was made.
  model       String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company            @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  pages     CompanyBriefPage[]

  @@unique([id, workspaceId])
  @@index([companyId, workspaceId, createdAt])
  @@index([workspaceId])
  @@index([createdById])
  // This person's briefs in the last 24 hours, counted before each new one.
  @@index([workspaceId, createdById, createdAt])
}

// One approved URL a brief tried to read: what was fetched (and when), or why it was skipped. The
// stored text is exactly what the AI was shown (contact details masked), so quotes are checked
// against it.
model CompanyBriefPage {
  id          String    @id @default(cuid())
  workspaceId String
  briefId     String
  // Order in the prompt (1-based); the AI cites pages by this number.
  position    Int
  url         String
  // Where the last redirect landed; null if the page wasn't fetched.
  finalUrl    String?
  fetchedAt   DateTime? @db.Timestamptz(3)
  // A short code like "robots" or "too_large" when the page was skipped.
  skipReason  String?
  // SHA-256 of the stored text.
  sha256      String?
  text        String?
  // Phrases that looked like instructions to an AI ("ignore previous instructions" ...).
  injection   String[]  @default([])
  // Team inboxes (careers@, university.relations@ ...) found on the page by code, never by the AI.
  inboxes     String[]  @default([])

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brief     CompanyBrief @relation(fields: [briefId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([briefId, position])
  @@index([briefId, workspaceId])
  @@index([workspaceId])
}

// How far one person has got through the onboarding tours in one workspace (components/ledger/tour.tsx).
// No row means the basics have not started, so existing members take them once on their next visit.
// Only that person can read or write their own row, owners included (row-level security in the
// migration). Steps are indexes into lib/onboarding-steps.ts and only ever move forward.
model OnboardingProgress {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  // The next basics card not yet seen, so a reload or another device picks up where they left off.
  basicsStep    Int       @default(0)
  basicsDoneAt  DateTime? @db.Timestamptz(3)
  // "owner" or "member": the role the basics were finished as. An officer made owner later sees
  // only the invite card once.
  basicsRole    String?
  aiStep        Int       @default(0)
  aiDoneAt      DateTime? @db.Timestamptz(3)
  // "Later" on the offer, or the AI tour ended early. It stays in the account menu.
  aiDismissedAt DateTime? @db.Timestamptz(3)
  // "Hide" on the basics: later page loads show only the Resume pill. Cleared on Resume.
  basicsHiddenAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ----- AI (feature 7: Scorecard explanation and the Template Lab) -----

// The words around the stats page's numbers, written by the AI and checked by code. The numbers
// are never the model's: each is a fact chip rendered from `facts`, the fact table the narrative
// was written about. One current narrative per workspace; a new one replaces it (lib/scorecard/).
model ScorecardNarrative {
  id          String   @id @default(cuid())
  workspaceId String
  // A hash of the fact table's keys and values when this was written. If today's differs, the
  // page says the numbers have changed since.
  statsHash   String
  facts       Json
  paragraphs  Json
  model       String
  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workspaceId])
  @@index([createdById])
}

enum ExperimentStatus {
  RUNNING
  ENDED
}

// A template tested against one or two one-change variants of itself (lib/template-lab/). One
// RUNNING per workspace: the migration adds a partial unique index on (workspaceId) where the
// status is RUNNING, which Prisma can't express here. Nothing is ever deleted when it ends.
model TemplateExperiment {
  id             String           @id @default(cuid())
  workspaceId    String
  baseTemplateId String
  status         ExperimentStatus @default(RUNNING)
  startedById    String
  startedAt      DateTime         @default(now()) @db.Timestamptz(3)
  endedAt        DateTime?        @db.Timestamptz(3)
  keptTemplateId String?

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedBy    User            @relation(fields: [startedById], references: [id], onDelete: Restrict)
  // NoAction like Outreach's draft: a template is archived, never deleted.
  baseTemplate Template        @relation("ExperimentBase", fields: [baseTemplateId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  keptTemplate Template?       @relation("ExperimentKept", fields: [keptTemplateId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  arms         ExperimentArm[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([startedById])
  @@index([baseTemplateId, workspaceId])
  @@index([keptTemplateId, workspaceId])
}

// One template taking part in an experiment: "A" is the original, then "B" and "C".
model ExperimentArm {
  id           String @id @default(cuid())
  workspaceId  String
  experimentId String
  templateId   String
  label        String
  // "original", or the kind of change: opening, ask, closing or shorter.
  kind         String
  summary      String

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  experiment TemplateExperiment @relation(fields: [experimentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  template   Template           @relation(fields: [templateId, workspaceId], references: [id, workspaceId], onDelete: NoAction)

  @@unique([experimentId, templateId])
  @@index([experimentId, workspaceId])
  @@index([templateId, workspaceId])
  @@index([workspaceId])
}
